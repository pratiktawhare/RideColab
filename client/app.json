{
  "expo": {
    "name": "RideColab",
    "slug": "ridecolab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ridecolab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.ridecolab.app"
    },
    "android": {
      "package": "dev.ridecolab.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1B33",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b79af509-b6a7-40f8-bd43-e86f550a8591"
      }
    },
    "owner": "pratiktawhare"
  }
}
