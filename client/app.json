{
  "expo": {
    "name": "RideColab",
    "slug": "ridecolab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ridecolab",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.ridecolab.app"
    },
    "android": {
      "package": "dev.ridecolab.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1B33",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RideColab needs your location to match routes and provide live ride tracking."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RideColab accesses your photos for licence, document, and profile photo upload."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F1B33"
        }
      ],
      "@maplibre/maplibre-react-native",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b79af509-b6a7-40f8-bd43-e86f550a8591"
      }
    },
    "owner": "pratiktawhare"
  }
}
