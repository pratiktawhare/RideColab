# ============================================================
# RideColab Mobile App — Environment Variables
# ============================================================
# Copy this file to .env and fill in values.
# All client env vars MUST be prefixed with EXPO_PUBLIC_
# so they are bundled into the app.
# NEVER commit .env to git.
# ============================================================

# URL of the backend server
# Local development (same Wi-Fi as your phone):
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Production (fill in Phase 15 after Render deployment):
# EXPO_PUBLIC_API_URL=https://YOUR-APP.onrender.com/api/v1

# Map tile URL (Phase 4) — OpenFreeMap default (free, no key)
# EXPO_PUBLIC_MAP_TILE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_MAP_TILE_URL=FILL_IN_PHASE_4

# Google OAuth Web Client ID (from Google Cloud Console → APIs & Services → Credentials)
# Used by expo-auth-session for "Continue with Google". Must be the WEB client ID (not Android/iOS).
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=FILL_IN
