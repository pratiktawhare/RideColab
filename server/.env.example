# ============================================================
# RideColab Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_VERSION=1.0.0

# ── Security ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Database (Phase 2) ───────────────────────────────────────
# Get from: https://neon.tech → your project → Connection Details → Pooled connection string
# DATABASE_URL=postgresql://USER:PASS@HOST/DBNAME?sslmode=require
DATABASE_URL=FILL_IN_PHASE_2

# ── Cache / Redis (Phase 2, optional) ────────────────────────
# Get from: https://upstash.com → Redis → your database → REST API
# Leave empty to use in-memory fallback (app works without Redis)
# REDIS_URL=https://YOUR-DB.upstash.io
# REDIS_TOKEN=YOUR_UPSTASH_REST_TOKEN
REDIS_URL=
REDIS_TOKEN=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Admin seed user (Phase 2) ─────────────────────────────────
# Used by the seed script to create the first admin account
ADMIN_EMAIL=admin@ridecolab.dev
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── OpenRouteService (Phase 5) ───────────────────────────────
# Get from: https://openrouteservice.org → Dashboard → API Keys (free, 2K req/day)
# ORS_API_KEY=YOUR_ORS_API_KEY
ORS_API_KEY=FILL_IN_PHASE_5

# ── Chat encryption (Phase 8) ────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_CHAT_SECRET=FILL_IN_PHASE_8

# ── Expo Push (Phase 8) ──────────────────────────────────────
# Get from: https://expo.dev → your account → Access Tokens
EXPO_PUSH_ACCESS_TOKEN=FILL_IN_PHASE_8

# ── Google OAuth (Phase 3, optional) ─────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=FILL_IN_PHASE_3_OPTIONAL
GOOGLE_CLIENT_SECRET=FILL_IN_PHASE_3_OPTIONAL
